.DS_Store
__pycache__/
*.pyc

# Deployable kits: kexts, EFI backups, configs with machine identity, runtime logs
/outputs/

# Dependencies, build output and reference repositories (see README.md)
/deps/
/build/
/reference/

# Wi-Fi: the driver keeps its own rules in wifi/airportbz/.gitignore; test results stay local.
/wifi/kit/checks.json
/wifi/kit/tests/

# Bluetooth: sources, build scripts, Info plists, licences and the firmware only.
# Test dumps and generated patch pages (they hold device data or Apple code) stay local.
/bluetooth/**
!/bluetooth/**/
!/bluetooth/**/*.c
!/bluetooth/**/*.cpp
!/bluetooth/**/*.h
!/bluetooth/**/*.hpp
!/bluetooth/**/*.py
!/bluetooth/**/*.md
!/bluetooth/release.json
!/bluetooth/*/Info.plist
!/bluetooth/*/Info.template.plist
!/bluetooth/*/LICENSE
!/bluetooth/firmware/fw/*
/bluetooth/**/*.dSYM/

# Research: scripts, sources and notes only; dumps, captures, plists and json stay local.
/research/**
!/research/**/
!/research/**/*.c
!/research/**/*.cpp
!/research/**/*.h
!/research/**/*.hpp
!/research/**/*.m
!/research/**/*.py
!/research/**/*.sh
!/research/**/*.md
/research/**/*.dSYM/
